rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // ─── Helpers ────────────────────────────────────────────────
    function isAdmin() {
      return request.auth != null
             && exists(/databases/$(database)/documents/admins/$(request.auth.uid));
    }

    // ─── User Profile Data ───────────────────────────────────────
  match /users/{userId} {
    allow read: if request.auth != null && (request.auth.uid == userId || isAdmin());

    allow create: if request.auth != null && request.auth.uid == userId
                  && !('conditions' in request.resource.data)
                  && !('allergens' in request.resource.data);

    allow update: if request.auth != null && request.auth.uid == userId
                  && !request.resource.data.diff(resource.data).affectedKeys()
                       .hasAny(['conditions', 'allergens']);

    allow delete: if request.auth != null && request.auth.uid == userId;
  }

    // ─── Scan History ────────────────────────────────────────────
    // Scan history is stored as a sub-collection under each user.
    match /users/{userId}/scan_history/{scanId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }

    // ─── History (scans + comparisons, used by HistoryService) ────
    match /users/{userId}/history/{itemId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }

    // ─── Favorites ──────────────────────────────────────────────
    match /users/{userId}/favorites/{productId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }

    // ─── Products (global, read-only for authenticated users) ───
    match /products/{productId} {
      allow read: if request.auth != null;
      allow write: if false; // admin-only via console or Cloud Functions
    }

    // ─── FDA Products (global) ─────────────────────────────────────
    // This is the actual live collection FirestoreProductRepository reads
    // from (see data/repositories/product_repository.dart) -- separate
    // from /products above, which appears to be an older/different
    // collection name.
    //
    // Write is gated by isAdmin(), not `if false` -- the admin dashboard's
    // reportService.js promotes approved reports into this collection
    // using the regular client SDK (setDoc/updateDoc), not the Admin SDK,
    // so it's a real, rule-checked write path, not just console/script
    // access. tools/bulk-import/import.js uses a Firebase service account
    // (Admin SDK), which bypasses these rules entirely regardless of what
    // this says -- this rule only affects client-SDK writes (admin
    // dashboard, and the Flutter app if it ever writes here directly,
    // which it currently doesn't).
    match /fda_products/{productId} {
      // Product catalog data is public app content. Guest users need the same
      // live FDA/product reads as signed-in users.
      allow read: if true;
      allow write: if isAdmin();
    }

    // ─── Product Nutrition Data (global) ───────────────────────────
    // Nutrition/ingredients/allergens, populated by the OCR + Gemini
    // extraction pipeline -- either tools/bulk-import (Admin SDK, bypasses
    // these rules) or admin-approved user reports (client SDK, subject to
    // this rule). Read policy matches fda_products since NutritionService
    // (Flutter app) reads both together to build one enriched Product.
    match /product_nutrition_data/{productId} {
      // Nutrition and ingredient data is public product content, not profile data.
      allow read: if true;
      allow write: if isAdmin();
    }

    // ─── User-submitted unknown products ─────────────────────────
    match /submitted_products/{submissionId} {
      allow create: if request.auth != null
                    && request.resource.data.submittedBy == request.auth.uid;
      allow read: if request.auth != null
                  && resource.data.submittedBy == request.auth.uid;
      allow update, delete: if false; // admin review only
    }

    // ─── Login OTP Challenges ─────────────────────────────────────
    // OTP challenges are stored keyed by user UID. Read is intentionally
    // public because verifyOtp() runs while the user is signed out — see
    // the earlier note about this being a soft spot if a uid ever leaks.
    match /login_otps/{userId} {
      allow read: if true;
      allow create: if request.auth != null && request.auth.uid == userId;
      allow update: if request.auth != null && request.auth.uid == userId;
      allow delete: if true;
    }

    // ─── App Suggestions/Reviews ("suhestiyon") ───────────────────
    // Auto-ID documents — a user can submit multiple reviews over time.
    // Each doc is tagged with the submitter's uid. Only the owner or an
    // admin can read a given review; only an admin can change status or
    // write a reply.
    match /suhestiyon/{reviewId} {
      allow create: if request.auth != null
                    && request.resource.data.uid == request.auth.uid;
      allow read: if request.auth != null
                  && (resource.data.uid == request.auth.uid || isAdmin());
      allow update: if isAdmin(); // status changes + adminReply, admin-only
      allow delete: if isAdmin();
    }

    // ─── Admins ─────────────────────────────────────────────────
    // isAdmin() (defined above) gates writes on fda_products,
    // product_nutrition_data, and suhestiyon -- so this collection's rules
    // matter more than "just a profile doc".
    //
    // No `create` from the client at all: this codebase has no admin
    // signup flow (authService.js only ever reads this doc to check
    // membership) -- admin accounts must be provisioned manually, out of
    // band, via the Firebase Console or a trusted Admin-SDK script, with
    // the Auth user and this Firestore doc created together. Previously
    // `allow write: if request.auth != null && request.auth.uid == uid`
    // let ANY signed-in user create their own /admins/{their-uid} doc and
    // instantly pass isAdmin() -- and since this project's Auth is shared
    // with the CLARO mobile app, "any signed-in user" meant any ordinary
    // app user too, not just people testing this dashboard.
    //
    // `update` is scoped to exactly the two fields the app's own code
    // touches (see services/profileService.js: updateUsername() writes
    // `name`, changePasswordFirstTime() writes `mustChangePassword`) --
    // notably NOT `active`, so a disabled admin can't reactivate their own
    // account this way, and nothing else can be smuggled into the same
    // write.
    match /admins/{uid} {
      allow read: if request.auth != null && request.auth.uid == uid;
      allow create: if false;
      allow update: if request.auth != null
                    && request.auth.uid == uid
                    && request.resource.data.diff(resource.data).affectedKeys()
                         .hasOnly(['name', 'mustChangePassword']);
      allow delete: if false;
    }

    match /otps/{uid} {
      allow read, write: if request.auth != null && request.auth.uid == uid;
    }

    // ─── Unknown Product Reports ──────────────────────────────────
    // Users can create their own reports (enforced by `reportedBy` field
    // matching their uid). Offline-persistence write queuing relies on
    // this exact `create` rule — queued writes are replayed with the
    // same auth token when connectivity is restored, so the
    // `reportedBy == request.auth.uid` check naturally passes.
    // Update and delete are admin-only: users cannot retract or modify a
    // report once submitted, and admins approve/reject via the dashboard.
    match /reports/{reportId} {
      allow create: if request.auth != null
                    && request.resource.data.reportedBy == request.auth.uid;
      allow read:   if request.auth != null
                    && (resource.data.reportedBy == request.auth.uid || isAdmin());
      allow update: if isAdmin();
      allow delete: if isAdmin();
    }

    match /approved_unknown_product_reports/{reportId} {
      allow read, write: if request.auth != null;
    }

    match /activity_logs/{logId} {
      allow read, write: if request.auth != null;
    }

    // ─── Health Groups ───────────────────────────────────────────
    // Groups allow users to share health data with family members.
    // Each group has an owner (ownerUid) and members stored in a subcollection.
    match /groups/{groupId} {
      // Helper to check if request.auth.uid is the group owner
      function isOwner() {
        return request.auth != null && resource.data.ownerUid == request.auth.uid;
      }
      
      // Helper to check if request.auth.uid is a member of this group
      function isMember() {
        return request.auth != null 
               && exists(/databases/$(database)/documents/groups/$(groupId)/members/$(request.auth.uid));
      }
      
      // For list operations, we can't use resource.data (it doesn't exist yet)
      // So we allow listing if the user is authenticated - the client will filter
      // This is safe because the query in getGroups() uses where('ownerUid', isEqualTo: uid)
      // for owned groups and gets specific IDs for joined groups
      allow list: if request.auth != null;
      
      // Allow read for owner or members
      allow read: if request.auth != null && (isOwner() || isMember());
      
      // Allow get for owner or members
      allow get: if request.auth != null && (isOwner() || isMember());
      
      // Allow create: owner creates the group with their uid as ownerUid
      allow create: if request.auth != null 
                    && request.resource.data.ownerUid == request.auth.uid;
      
      // Allow update: only owner can update group metadata
      allow update: if request.auth != null && isOwner();
      
      // Allow delete: only owner can delete
      // Note: The client-side validation in GroupRepository.deleteGroup() 
      // ensures no active members remain before attempting deletion
      allow delete: if request.auth != null && isOwner();
      
      // ─── Group Members ───────────────────────────────────────
      match /members/{memberId} {
        // Helper to check if request.auth.uid is the group owner
        // Need to check the parent group document since member docs don't have ownerUid
        function isGroupOwner() {
          return request.auth != null 
                 && exists(/databases/$(database)/documents/groups/$(groupId))
                 && get(/databases/$(database)/documents/groups/$(groupId)).data.ownerUid == request.auth.uid;
        }
        
        // Helper to check if this member is the authenticated user (linked member)
        function isThisUser() {
          return request.auth != null && request.auth.uid == memberId;
        }
        
        // Helper to check if this member is a linked member (has linkedUid field)
        function isLinkedMember() {
          return resource.data.sourceType == 'linked';
        }
        
        // Allow list/read for owner or members (needed for queries like watchMembers)
        allow list, read: if request.auth != null && (isGroupOwner() || isMember());
        
        // Allow get for owner or the member themselves
        allow get: if request.auth != null && (isGroupOwner() || isThisUser());
        
        // Allow create: owner can add members
        allow create: if request.auth != null && isGroupOwner();
        
        // Allow update: owner can update any fields on managed members (including health data via Worker)
        // Linked users can update their own display name or mark themselves
        // as left. Health data and membership ownership remain protected.
        allow update: if request.auth != null 
                      && (isGroupOwner() 
                          || (isThisUser() && isLinkedMember() 
                    && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'displayName'])));
        
        // Allow delete: owner can delete managed members
        allow delete: if request.auth != null && isGroupOwner();
      }
      
      // ─── Group Invites ───────────────────────────────────────
      match /invites/{inviteCode} {
        // Helper to check if request.auth.uid is the group owner
        function isGroupOwner() {
          return request.auth != null 
                 && exists(/databases/$(database)/documents/groups/$(groupId))
                 && get(/databases/$(database)/documents/groups/$(groupId)).data.ownerUid == request.auth.uid;
        }
        
        // Allow list for owner (to check invite status)
        allow list: if request.auth != null && isGroupOwner();
        
        // Allow get for owner (to check invite status)
        allow get: if request.auth != null && isGroupOwner();
        
        // Allow create: createdBy must match authenticated user (client validates group ownership)
        allow create: if request.auth != null 
                      && request.resource.data.createdBy == request.auth.uid;
        
        // Allow update: owner can revoke invites, or invite can be redeemed
        allow update: if request.auth != null 
                      && (isGroupOwner() 
                          || (request.resource.data.status == 'redeemed' 
                              && resource.data.status == 'pending'));
        
        // Allow delete: owner can delete invites
        allow delete: if request.auth != null && isGroupOwner();
      }
    }
    
    // ─── Invite Codes Lookup ───────────────────────────────────
    // Top-level collection for invite code lookup without knowing the group ID
    match /inviteCodes/{code} {
      // Allow read for authenticated users (to redeem invites)
      allow read: if request.auth != null;
      
      // Allow create/delete: only through group operations (by owner)
      allow create, delete: if false;
      
      // Allow update: only through group operations
      allow update: if false;
    }

    // ─── Deny everything else by default ─────────────────────────
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
