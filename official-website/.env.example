# Cloudflare Worker Configuration
# The official-website now uses the Cloudflare Worker for secure email sending
# instead of exposing EmailJS credentials in the client-side JavaScript bundle

# Cloudflare Worker URL (claro-gemini-proxy)
VITE_GEMINI_PROXY_URL=https://claro-gemini-proxy.claro-app.workers.dev

# Shared secret for authenticating requests to the Cloudflare Worker
# This must match the APP_SHARED_SECRET set in the Worker
VITE_APP_SHARED_SECRET=your_app_shared_secret_here
