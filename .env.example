CLOUDINARY_CLOUD_NAME=
CLOUDINARY_UPLOAD_PRESET=

GEMINI_MODEL=
GEMINI_PROXY_URL=
APP_SHARED_SECRET=

# CORS Configuration for Cloudflare Workers
# Comma-separated list of allowed origins for claro-gemini-proxy and health-data-worker
# Leave empty for wildcard (NOT recommended for production)
# Production example: https://claro-admin.onrender.com,https://claro-52ia.onrender.com
# For development: http://localhost:3000,http://localhost:5173
# NOTE: Native mobile apps (Flutter, iOS, Android) don't need CORS configuration
# They don't send Origin header, so they work regardless of this setting
CORS_ALLOWED_ORIGINS=

