# Copy this file to .env and fill in real values. Never commit .env itself.

# Same Gemini API key used by the Flutter app's .env (GEMINI_API_KEY)
GEMINI_API_KEY=

# Path to a Firebase service account JSON key with Firestore write access.
# Firebase Console > Project Settings > Service Accounts > Generate new
# private key. This grants full write access bypassing security rules --
# keep it out of version control and delete/rotate it once you're done
# with bulk imports if you don't plan to reuse this tool.
GOOGLE_APPLICATION_CREDENTIALS=./serviceAccountKey.json
